# Sign-in (Auth.js). Generate the secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed for `npm start` outside Vercel
# AUTH_TRUST_HOST=true
ALLOWED_EMAIL_DOMAINS=student.mahidol.edu,student.mahidol.ac.th

# Data: "sheets" or "csv"
DATA_SOURCE=sheets
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional tab names
# SHEET_TAB_SI129=SI129
# SHEET_TAB_SI130=SI130
# SHEET_TAB_HOSPITALS=hospitals
# SHEET_TAB_ALIASES=aliases

# Link for "report or remove a review" (hidden when empty)
REPORT_URL=

# Local preview only. Ignored unless running `npm run dev` with DATA_SOURCE=csv
# DEV_APPROVE_ALL=1
# AUTH_DEV_BYPASS=1
